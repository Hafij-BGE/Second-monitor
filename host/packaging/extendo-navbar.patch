+// Extendo: thick line for the navigation icons
+static void
+navbar_line(SDL_Renderer *r, int x1, int y1, int x2, int y2, int t) {
+    for (int d = -t / 2; d <= t / 2; ++d) {
+        SDL_RenderDrawLine(r, x1 + d, y1, x2 + d, y2);
+        SDL_RenderDrawLine(r, x1, y1 + d, x2, y2 + d);
+    }
+}
+
+static void
+navbar_draw(SDL_Renderer *r, const struct sc_navbar *nav) {
+    const SDL_Rect *b = &nav->rect;
+    Uint8 cr, cg, cb, ca;
+    SDL_GetRenderDrawColor(r, &cr, &cg, &cb, &ca);
+
+    SDL_SetRenderDrawColor(r, 0x14, 0x15, 0x1d, 0xff);
+    SDL_RenderFillRect(r, b);
+    SDL_SetRenderDrawColor(r, 0x2a, 0x2d, 0x3a, 0xff);
+    SDL_RenderDrawLine(r, b->x, b->y, b->x + b->w, b->y);
+
+    int third = b->w / 3;
+    if (nav->pressed >= 0 && nav->pressed <= 2) {
+        SDL_Rect hl = {b->x + nav->pressed * third, b->y + 1, third, b->h - 1};
+        SDL_SetRenderDrawColor(r, 0x2c, 0x30, 0x48, 0xff);
+        SDL_RenderFillRect(r, &hl);
+    }
+
+    int s = b->h * 36 / 100;           // icon size
+    int t = b->h >= 60 ? 4 : 3;        // stroke width
+    int cy = b->y + b->h / 2;
+    SDL_SetRenderDrawColor(r, 0xe4, 0xe6, 0xf0, 0xff);
+
+    // Back: left-pointing triangle
+    int cx = b->x + third / 2;
+    int h = s / 2;
+    navbar_line(r, cx + h, cy - h, cx - h, cy, t);
+    navbar_line(r, cx - h, cy, cx + h, cy + h, t);
+    navbar_line(r, cx + h, cy + h, cx + h, cy - h, t);
+
+    // Home: circle
+    cx = b->x + third + third / 2;
+    for (int deg = 0; deg < 360; ++deg) {
+        double a = deg * 3.14159265358979 / 180.0;
+        for (int k = -t / 2; k <= t / 2; ++k) {
+            double rr = h + k * 0.7;
+            SDL_RenderDrawPoint(r, cx + (int) (rr * SDL_cos(a)),
+                                   cy + (int) (rr * SDL_sin(a)));
+        }
+    }
+
+    // Recents: square
+    cx = b->x + 2 * third + third / 2;
+    int q = h * 85 / 100;
+    for (int k = 0; k < t; ++k) {
+        SDL_Rect sq = {cx - q + k, cy - q + k, 2 * (q - k), 2 * (q - k)};
+        SDL_RenderDrawRect(r, &sq);
+    }
+
+    SDL_SetRenderDrawColor(r, cr, cg, cb, ca);
+}
+
 enum sc_display_result
 sc_display_render(struct sc_display *display, const SDL_Rect *geometry,
-                  enum sc_orientation orientation) {
+                  enum sc_orientation orientation,
+                  const struct sc_navbar *navbar) {
     SDL_RenderClear(display->renderer);
 
     if (display->pending.flags) {
@@ -346,6 +408,10 @@
         }
     }
 
+    if (navbar && navbar->rect.w > 0 && navbar->rect.h > 0) {
+        navbar_draw(display->renderer, navbar);
+    }
+
     SDL_RenderPresent(display->renderer);
     return SC_DISPLAY_RESULT_OK;
 }
