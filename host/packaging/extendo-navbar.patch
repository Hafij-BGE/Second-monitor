+// Extendo: presses or releases a navigation bar button
+static void
+navbar_press(struct sc_input_manager *im, int button, bool down) {
+    enum sc_action action = down ? SC_ACTION_DOWN : SC_ACTION_UP;
+    switch (button) {
+        case 0:
+            action_back(im, action);
+            break;
+        case 1:
+            action_home(im, action);
+            break;
+        case 2:
+            action_app_switch(im, action);
+            break;
+        default:
+            return;
+    }
+    im->screen->navbar.pressed = down ? button : -1;
+    sc_screen_redraw(im->screen);
+}
+
+// Extendo: handles a press/release at window (x, y) if it is on the bar.
+// Returns true if consumed.
+static bool
+navbar_handle(struct sc_input_manager *im, int32_t x, int32_t y, bool down) {
+    if (!im->controller || !im->kp || im->screen->paused) {
+        return false;
+    }
+    int pressed = im->screen->navbar.pressed;
+    if (!down && pressed >= 0) {
+        navbar_press(im, pressed, false);
+        return true;
+    }
+    if (down) {
+        int hit = sc_screen_navbar_hit(im->screen, x, y);
+        if (hit >= 0) {
+            navbar_press(im, hit, true);
+            return true;
+        }
+    }
+    return false;
+}
