+
+int
+sc_screen_navbar_hit(struct sc_screen *screen, int32_t x, int32_t y) {
+    if (!screen->navbar_h || !screen->video) {
+        return -1;
+    }
+    int ww;
+    int wh;
+    SDL_GetWindowSize(screen->window, &ww, &wh);
+    if (y < wh - screen->navbar_h || y >= wh || x < 0 || x >= ww || ww < 3) {
+        return -1;
+    }
+    return MIN(2, x * 3 / ww);
+}
+
+void
+sc_screen_redraw(struct sc_screen *screen) {
+    if (screen->video && screen->has_frame) {
+        sc_screen_render(screen, false);
+    }
+}
